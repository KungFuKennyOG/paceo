# Paceo deployment settings. Copy to deploy/.env, fill in, then: chmod 600 .env
# Never commit .env. Keep a copy of PACEO_ENCRYPTION_KEY in your password manager:
# without it, stored intervals.icu keys can't be decrypted (users would have to reconnect).

# ── Database (docker compose builds DATABASE_URL from this) ──
# Use hex so it needs no URL-escaping:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Only needed when running the API outside compose (e.g. pnpm dev):
# DATABASE_URL=postgres://paceo:<password>@localhost:5432/paceo

# ── Required secrets ──
# Signs the session cookie. ≥ 32 chars:  openssl rand -base64 48
SESSION_SECRET=
# AES-256-GCM key for per-user secrets. Exactly 32 bytes, base64:  openssl rand -base64 32
PACEO_ENCRYPTION_KEY=
# Bump when rotating; put the old key in PACEO_ENCRYPTION_KEY_PREVIOUS as "<version>:<base64>".
PACEO_ENCRYPTION_KEY_VERSION=1
PACEO_ENCRYPTION_KEY_PREVIOUS=

# Web push (VAPID). Required in production. Generate once:
#   docker compose run --rm api node dist/cli/vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Public URL / HTTPS ──
PUBLIC_URL=https://paceo.example.com
# Cloudflare Tunnel token (profile "tunnel"): Zero Trust → Networks → Tunnels → your tunnel → token.
TUNNEL_TOKEN=
# Caddy (profile "caddy"): the domain whose DNS A/AAAA record points at this machine.
DOMAIN=paceo.example.com

# ── Optional ──
# Host port the API binds on 127.0.0.1 (compose).
API_PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
SESSION_TTL_DAYS=60
# Defaults to true in production. Set false only for plain-HTTP testing on a LAN.
# COOKIE_SECURE=true
# Local hour for the "today's workout" push and for nightly reconcile/replan/re-send.
MORNING_PUSH_HOUR=7
NIGHTLY_HOUR=3
# Run workers and cron in this process (keep true unless you run a separate worker).
JOBS_ENABLED=true
# healthchecks.io (or similar) URL, pinged every 15 min by the job dispatcher. Set the check's period to 15 min.
HEALTHCHECK_PING_URL=
# intervals.icu client. The per-IP limit is 10 req/s; stay at or below 5.
INTERVALS_BASE_URL=https://intervals.icu/api/v1
INTERVALS_RATE_PER_SEC=5
# INTERVALS_USER_AGENT=Mozilla/5.0 (...) Paceo/0.1
# Built PWA to serve. The image sets this; only change it when running outside Docker.
# WEB_DIST_DIR=/repo/apps/web/dist
# HOST=0.0.0.0
# PORT=3000

# ── Backups (deploy/backup.sh) ──
BACKUP_DIR=/var/backups/paceo
KEEP_DAILY=14
KEEP_WEEKLY=8
# rclone remote for off-box copies, ideally a "crypt" remote, e.g. paceo-crypt:backups
RCLONE_REMOTE=
