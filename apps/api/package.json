{
  "name": "@paceo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "drizzle-kit generate --name init && for f in drizzle/*.sql drizzle/meta/*.json; do echo \"=====FILE $f\"; cat \"$f\"; echo; done && vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "admin:create-invite": "tsx src/cli/create-invite.ts",
    "vapid:generate": "tsx src/cli/vapid-keys.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^10.0.0",
    "@garmin/fitsdk": "^21.170.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "pg": "^8.13.0",
    "pg-boss": "^12.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@paceo/contracts": "workspace:*",
    "@paceo/engine": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
